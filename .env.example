# Strapi CMS (cms.masjidalqosim.com)
STRAPI_URL="https://cms.masjidalqosim.com"
NEXT_PUBLIC_STRAPI_URL="https://cms.masjidalqosim.com"
# Optional: only needed when the public role cannot read the content types.
# Create a read-only token in Strapi Admin -> Settings -> API Tokens.
STRAPI_API_TOKEN=""

# Secret shared with the Strapi webhook (Settings -> Webhooks).
# Generate with: openssl rand -base64 32
STRAPI_WEBHOOK_SECRET="your-secret-key-here"

# Local development with the CMS running on localhost:1337:
# STRAPI_URL="http://localhost:1337"
# NEXT_PUBLIC_STRAPI_URL="http://localhost:1337"
