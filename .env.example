# Strapi CMS (https://cms.masjidalqosim.com)
STRAPI_URL="https://cms.masjidalqosim.com"
NEXT_PUBLIC_STRAPI_URL="https://cms.masjidalqosim.com"

# Read-only API token (Strapi admin → Settings → API Tokens)
STRAPI_API_TOKEN="your-strapi-api-token"

# Secret sent by the Strapi webhook (x-webhook-secret header)
# Generate with: openssl rand -base64 32
STRAPI_WEBHOOK_SECRET="your-secret-key-here"
